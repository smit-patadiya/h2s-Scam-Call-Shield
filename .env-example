# Copy this file to .env and fill in your key from https://aistudio.google.com/
GEMINI_API_KEY=your_key_here

# Optional overrides
# Max Gemini requests per minute per model (0 = no cap). Free tier: about 5 for Flash, 3 for TTS.
# GEMINI_RPM=5
# GEMINI_TTS_RPM=3
# ANALYZE_MODEL=gemini-4-argon
# TTS_MODEL=gemini-3.8-flash-tts
# TTS_FALLBACK_MODEL=gemini-2.5-pro-preview-tts
# PORT=8080
